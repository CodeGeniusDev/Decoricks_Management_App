{
  "name": "decoricks-managment-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "migrate:task-assignees": "tsx scripts/migrate-tasks-assignees.ts",
    "migrate:task-assignees:apply": "DRY_RUN=false tsx scripts/migrate-tasks-assignees.ts",
    "seed:e2e": "tsx scripts/seed-e2e.ts",
    "cleanup:e2e": "tsx scripts/cleanup-e2e-data.ts",
    "cleanup:e2e:apply": "tsx scripts/cleanup-e2e-data.ts --apply",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "gsap": "^3.15.0",
    "mongodb": "^6.21.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "eslint-plugin-react": "^7.37.5",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
