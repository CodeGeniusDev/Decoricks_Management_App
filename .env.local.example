# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@decoricks-cluster0.q4qnwaa.mongodb.net/?appName=Decoricks-Cluster0

# Test databases only. Set ONLY alongside NODE_ENV=test — src/lib/mongodb.ts
# refuses to honour this variable otherwise, so a stray value in .env.local
# cannot redirect tests at production.
MONGODB_TEST_DB=decoricks_test

# ─────────────────────────────────────────────────────────────
# Sessions (replaces NextAuth)
# ─────────────────────────────────────────────────────────────
# Signs CSRF tokens. Minimum 16 characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-32-random-bytes

# Minutes of inactivity before a session expires. Defaults to 7 days; the
# window restarts on each qualifying (non-background) authenticated request.
SESSION_TTL_MINUTES=10080
# Minimum seconds between session slides, so bursts of requests do not cause
# bursts of writes. Auto-polling requests never slide.
SESSION_SLIDE_INTERVAL_SECONDS=60

# ─────────────────────────────────────────────────────────────
# Password policy
# ─────────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
BCRYPT_COST=12

# ─────────────────────────────────────────────────────────────
# Login lockout
# ─────────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOCKOUT_MINUTES=15

# ─────────────────────────────────────────────────────────────
# First Founder (used only by `npm run seed`)
# ─────────────────────────────────────────────────────────────
# The seed refuses to run against MONGODB_TEST_DB and will not overwrite an
# existing Founder's credentials on rerun.
FOUNDER_EMAIL=founder@decoricks.pk
FOUNDER_NAME=Abdullah
FOUNDER_PASSWORD=<at least 12 chars, upper+lower+number>

# ─────────────────────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────────────────────
NODE_ENV=developmentMONGODB_TEST_DB=decoricks_test
